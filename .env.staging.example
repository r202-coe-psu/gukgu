# Copy to .env.staging on the staging server; never commit the real file.
APP_TITLE="R202 Tracking Project (Staging)"
SECRET_KEY="change-me-to-a-long-random-string"

# Hostnames are docker-compose service names
MONGODB_DB="gukgu_db"
MONGODB_HOST="mongodb"
MONGODB_PORT=27017
MONGODB_USERNAME="gukgu"
MONGODB_PASSWORD="change-me"

# Used by the mongo container to create the root user on first start
# (only when the data directory is empty). Must match MONGODB_USERNAME/PASSWORD.
MONGO_INITDB_ROOT_USERNAME="gukgu"
MONGO_INITDB_ROOT_PASSWORD="change-me"

REDIS_URL="redis://redis:6379"

# Comma separated list of OAuth2 providers registered with Authlib
LOGIN_PROVIDERS="google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SERVER_METADATA_URL="https://accounts.google.com/.well-known/openid-configuration"
GOOGLE_CLIENT_KWARGS={"scope": "openid email profile"}
